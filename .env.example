# The Graph Token API Bearer Token (required)
# Get your token from: https://thegraph.com/market/
THEGRAPH_API_TOKEN=your_token_here

# The Graph Subgraph API Key (optional)
# Required only if you want to query subgraphs by ID using the gateway
# You can still query subgraphs using studio endpoints without this key
# Get your key from: https://thegraph.com/studio/apikeys/
THEGRAPH_SUBGRAPH_API_KEY=your_subgraph_key_here

# Default network for API requests (optional)
# Options: mainnet, arbitrum-one, avalanche, base, bsc, optimism, polygon, unichain
DEFAULT_NETWORK=mainnet

# Server configuration (optional)
PORT=3000
HOST=localhost
